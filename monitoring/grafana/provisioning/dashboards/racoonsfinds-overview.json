{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "HTTP request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (uri,method,status) (rate(http_server_requests_seconds_count{application=\"racoonsfinds-backend\"}[1m]))",
          "legendFormat": "{{method}} {{uri}} [{{status}}]"
        }
      ]
    },
    {
      "title": "HTTP latency p99 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le,uri) (rate(http_server_requests_seconds_bucket{application=\"racoonsfinds-backend\"}[5m])))",
          "legendFormat": "p99 {{uri}}"
        }
      ]
    },
    {
      "title": "JVM heap used (bytes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"racoonsfinds-backend\",area=\"heap\"})",
          "legendFormat": "{{area}}"
        }
      ]
    },
    {
      "title": "HikariCP active connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"racoonsfinds-backend\"}",
          "legendFormat": "active"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "title": "Racoonsfinds — Overview",
  "uid": "racoonsfinds-overview",
  "version": 1
}
